# ============================================================================
# Renti Backend — Contoh Environment (boleh di-commit)
# Salin file ini menjadi `backend/.env` lalu isi key milikmu. Jangan commit `.env`.
# ============================================================================

# 1. API keys (LLM providers)
# Kosong = mode mock/template (offline, deterministik)
GEMINI_API_KEY=
GROQ_API_KEY=

# 2. Model routing
LLM_PRIMARY_PROVIDER=gemini/gemini-2.0-flash
LLM_FALLBACK_PROVIDER=groq/llama-3.3-70b-versatile

# 3. Aplikasi & database
APP_NAME=renti-backend
TEAM_ID=RENTI-TEAM-01
DB_PATH=renti.db

# 4. Hotline krisis (signposting)
CRISIS_HOTLINE=119
