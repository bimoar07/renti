# ============================================================================
# Renti Backend — Contoh Environment (boleh di-commit)
# Salin file ini menjadi `.env` lalu isi key milikmu. Jangan commit `.env`.
# ============================================================================

# API keys — kosong = mode mock/template (offline, deterministik)
GEMINI_API_KEY=
GROQ_API_KEY=

# Provider LLM
LLM_PRIMARY_PROVIDER=gemini/gemini-2.0-flash
LLM_FALLBACK_PROVIDER=groq/llama-3.3-70b-versatile

# Identitas tim
TEAM_ID=RENTI-TEAM-01

# Path DB SQLite (relatif ke dir kerja saat uvicorn dijalankan)
DB_PATH=renti.db

# Hotline krisis (signposting)
CRISIS_HOTLINE=119
