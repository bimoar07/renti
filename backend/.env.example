# Renti Backend Environment Configuration Example
# Salin file ini menjadi `backend/.env` dan isi kunci API Anda (jangan pernah commit file .env!).

# 1. API Keys (LLM Providers)
# Kosongkan untuk mode offline / template deterministik
GEMINI_API_KEY=
GROQ_API_KEY=

# 2. Model Routing Configuration
LLM_PRIMARY_PROVIDER=gemini/gemini-2.0-flash
LLM_FALLBACK_PROVIDER=groq/llama-3.3-70b-versatile

# 3. Application & Database
APP_NAME=renti-backend
TEAM_ID=RENTI-TEAM-01
DB_PATH=renti.db

# 4. Emergency Crisis Hotline (Signposting)
CRISIS_HOTLINE=119
